rules_version = '2';
// 학생부 순찰 앱 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 통째로 붙여넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function meDoc() { return get(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && meDoc().data.active == true;
    }
    function isAdmin() { return isMember() && meDoc().data.isAdmin == true; }
    function joinCode() { return get(/databases/$(database)/documents/config/secret).data.joinCode; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 앱 설정 (시간대 등): 부원은 읽기, 관리자만 수정
    match /config/app {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // 가입 코드: 관리자만 보고 바꿀 수 있음
    match /config/secret {
      allow read, write: if isAdmin();
    }

    // 부원 정보
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      // 가입: 본인 문서만, 올바른 가입 코드 필요, 스스로 관리자가 될 수 없음
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == false
        && request.resource.data.active == true
        && request.resource.data.joinCode == joinCode();
      // 수정: 본인은 권한 관련 칸을 뺀 나머지만, 관리자는 전부
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !changed().hasAny(['isAdmin', 'active', 'joinCode']));
      allow delete: if isAdmin();
    }

    // 순찰 일정: 관리자는 전부, 부원은 대타 수락 시 담당자 교체만
    match /shifts/{id} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && changed().hasOnly(['memberIds', 'updatedAt', 'updatedBy']));
    }

    // 대타 요청
    match /requests/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isMember()
        && changed().hasOnly(['status', 'resolvedBy', 'resolvedByName', 'resolvedAt']);
    }

    // 채팅방: 단체방(all)은 모든 부원, 1:1 방은 두 사람만
    match /rooms/{roomId} {
      function inRoom() {
        return roomId == 'all'
          || request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
      }
      allow read: if isMember() && (roomId == 'all' || request.auth.uid in resource.data.members);
      allow create: if isMember() && (roomId == 'all' || request.auth.uid in request.resource.data.members);
      allow update: if isMember() && (roomId == 'all' || request.auth.uid in resource.data.members);

      match /messages/{mid} {
        allow read: if isMember() && inRoom();
        allow create: if isMember() && inRoom() && request.resource.data.uid == request.auth.uid;
      }
    }

    // 알림 대기열: 부원은 넣기만, 발송 서버가 읽고 지움
    match /outbox/{id} {
      allow create: if isMember();
    }

    // 변경 기록: 부원 누구나 남기고 볼 수 있음, 수정/삭제 불가
    match /history/{id} {
      allow read: if isMember();
      allow create: if isMember();
    }
  }
}
